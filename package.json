{
  "name": "stride",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run --project=unit --coverage --reporter=junit --outputFile=test-report.junit.xml --reporter=default && vitest run --project=storybook --coverage --coverage.reportsDirectory=./coverage-storybook --reporter=junit --outputFile=test-report-storybook.junit.xml --reporter=default",
    "test:ui": "vitest --ui",
    "test:e2e": "npx playwright test",
    "test:e2e:coverage": "PLAYWRIGHT_COVERAGE=true npm run build && PLAYWRIGHT_COVERAGE=true npx playwright test && nyc report",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.3.0",
    "@tanstack/react-query": "^5.103.2",
    "arktype": "^2.2.3",
    "axios": "^1.20.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "framer-motion": "^13.4.0",
    "jszip": "^3.10.2",
    "konva": "^10.7.0",
    "leaflet": "^1.9.4",
    "luxon": "^3.7.2",
    "mapbox-gl": "^3.31.0",
    "ol": "^10.10.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-konva": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@chromatic-com/storybook": "^5.3.1",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/luxon": "^3.7.5",
    "@types/mapbox-gl": "^3.5.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-istanbul": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "baseline-browser-mapping": "^2.11.26",
    "chromatic": "^18.9.5",
    "jsdom": "^30.1.1",
    "nyc": "^18.0.0",
    "playwright": "^1.63.0",
    "storybook": "^10.6.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^5.0.0",
    "vitest-browser-react": "^2.3.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
